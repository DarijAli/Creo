{{#each post_service_calls}}
{{>post_service_call}}

{{/each}}
{{#each get_service_calls}}
{{>get_service_call}}

{{/each}}

func {{name}}(client *http.Client) {
	var wg sync.WaitGroup

	{{#each post_service_calls}}
	wg.Add(1)
	go func() {
		defer wg.Done()
		{{name}}(client)
	}()
	{{/each}}

	{{#each get_service_calls}}
	wg.Add(1)
	go func() {
		defer wg.Done()
		{{name}}(client)
	}()
	{{/each}}

	wg.Wait()
}
