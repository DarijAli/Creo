package main

import (
    "net/http"
    "sync"
    "time"
)

var (
    clientOnce sync.Once
    client     *http.Client
)

func GetHTTPClient() *http.Client {
    clientOnce.Do(func() {
        client = &http.Client{
			Transport: &http.Transport{
				MaxIdleConns:        100,
				MaxIdleConnsPerHost: 50,
				MaxConnsPerHost:     50,
			},
			Timeout: 2 * time.Second,
		}
    })
    return client
}
